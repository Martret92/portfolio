---
import { getCollection } from 'astro:content';

import SiteHeader from '@components/SiteHeader.astro';
import { projects, type ProjectId } from '@content/projects';
import { locales, type Locale } from '@i18n/config';
import { getLocalizedPath } from '@i18n/routes';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getProjectEditorialEntry } from '@lib/projects';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    Object.values(projects).map((project) => ({
      params: { lang: locale, slug: project.slug },
      props: { locale, projectId: project.id },
    })),
  );
}

interface Props {
  locale: Locale;
  projectId: ProjectId;
}

const { locale, projectId } = Astro.props;
const t = useTranslations(locale);
const projectEntries = await getCollection('projects');
const projectEntry = getProjectEditorialEntry(
  projectEntries,
  projectId,
  locale,
);

if (!projectEntry) {
  throw new Error(`Missing ${locale} content for project ${projectId}`);
}

const homePath = getLocalizedPath(locale);
const pageTitle = `${projectEntry.data.title} — ${t.caseStudy.titleSuffix}`;
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={projectEntry.data.summary}
>
  <SiteHeader slot="header" locale={locale} pathname={Astro.url.pathname} />

  <article class="container case-study">
    <header class="project-intro stack">
      <p class="eyebrow">{t.caseStudy.label}</p>
      <h1>{projectEntry.data.title}</h1>
      <p class="measure project-summary">{projectEntry.data.summary}</p>
      <a class="back-link" href={homePath}>{t.caseStudy.backHome}</a>
    </header>

    <div class="case-study__sections">
      <section class="shell-section" aria-labelledby="overview-heading">
        <h2 id="overview-heading">{t.caseStudy.sections.overview.title}</h2>
        <p class="measure">
          {t.caseStudy.sections.overview.placeholder}
        </p>
      </section>

      <section
        class="shell-section"
        data-density="product"
        aria-labelledby="product-heading"
      >
        <h2 id="product-heading">{t.caseStudy.sections.product.title}</h2>
        <p class="measure">{t.caseStudy.sections.product.placeholder}</p>
      </section>

      <section
        class="shell-section"
        data-density="system"
        aria-labelledby="system-heading"
      >
        <h2 id="system-heading">{t.caseStudy.sections.system.title}</h2>
        <p class="measure">{t.caseStudy.sections.system.placeholder}</p>
      </section>

      <section class="shell-section" aria-labelledby="decisions-heading">
        <h2 id="decisions-heading">{t.caseStudy.sections.decisions.title}</h2>
        <p class="measure">
          {t.caseStudy.sections.decisions.placeholder}
        </p>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .case-study {
    padding-block: clamp(var(--space-7), 10vw, var(--space-9));
  }

  .project-intro {
    --stack-space: var(--space-5);

    max-inline-size: 58rem;
    padding-block-end: clamp(var(--space-8), 12vw, 8rem);
  }

  .eyebrow,
  h1,
  h2,
  p {
    margin-block: 0;
  }

  .eyebrow {
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--font-size-heading-lg);
  }

  h2 {
    font-size: var(--font-size-heading-sm);
  }

  .project-summary {
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
  }

  .back-link {
    inline-size: fit-content;
    min-block-size: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    font-weight: var(--font-weight-medium);
  }

  .case-study__sections {
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .shell-section {
    display: grid;
    gap: var(--density-gap);
    padding-block: clamp(var(--space-6), 7vw, var(--space-8));
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .shell-section p {
    color: var(--color-text-muted);
  }

  @media (width >= 48rem) {
    .shell-section {
      grid-template-columns: minmax(10rem, 1fr) minmax(0, 2fr);
      gap: var(--space-7);
      align-items: start;
    }
  }
</style>
