---
import { getCollection } from 'astro:content';

import DuckyArenaCaseStudy from '@components/DuckyArenaCaseStudy.astro';
import SiteHeader from '@components/SiteHeader.astro';
import { getProjectInspectionModel } from '@content/project-inspections';
import { getDuckyArenaContent } from '@content/projects/duckyarena';
import { projects, type ProjectId } from '@content/projects';
import { locales, type Locale } from '@i18n/config';
import { getLocalizedPath } from '@i18n/routes';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getProjectEditorialEntry } from '@lib/projects';
import InspectableProjectStage from '../../../islands/InspectableProjectStage';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    Object.values(projects).map((project) => ({
      params: { lang: locale, slug: project.slug },
      props: { locale, projectId: project.id },
    })),
  );
}

interface Props {
  locale: Locale;
  projectId: ProjectId;
}

const { locale, projectId } = Astro.props;
const t = useTranslations(locale);
const projectEntries = await getCollection('projects');
const projectEntry = getProjectEditorialEntry(
  projectEntries,
  projectId,
  locale,
);

if (!projectEntry) {
  throw new Error(`Missing ${locale} content for project ${projectId}`);
}

const homePath = getLocalizedPath(locale);
const isDuckyArena = projectId === 'duckyarena';
const duckyArenaContent = isDuckyArena
  ? getDuckyArenaContent(locale)
  : undefined;
const pageTitle = duckyArenaContent
  ? duckyArenaContent.metadata.title
  : `${projectEntry.data.title} — ${t.caseStudy.titleSuffix}`;
const pageDescription = duckyArenaContent
  ? duckyArenaContent.metadata.description
  : projectEntry.data.summary;
const inspectionModel = isDuckyArena
  ? undefined
  : getProjectInspectionModel(projectId, locale);
---

<BaseLayout locale={locale} title={pageTitle} description={pageDescription}>
  <SiteHeader slot="header" locale={locale} pathname={Astro.url.pathname} />

  {
    duckyArenaContent ? (
      <DuckyArenaCaseStudy content={duckyArenaContent} homePath={homePath} />
    ) : (
      <article class="container case-study" data-view-mode-scope>
        <header class="project-intro stack">
          <p class="eyebrow">{t.caseStudy.label}</p>
          <h1>{projectEntry.data.title}</h1>
          <p class="measure project-summary">{projectEntry.data.summary}</p>
          <a class="back-link" href={homePath}>
            {t.caseStudy.backHome}
          </a>
        </header>

        <div class="case-study__sections">
          <section class="shell-section" aria-labelledby="overview-heading">
            <h2 id="overview-heading">{t.caseStudy.sections.overview.title}</h2>
            <p class="measure">{t.caseStudy.sections.overview.placeholder}</p>
          </section>

          {inspectionModel && (
            <InspectableProjectStage model={inspectionModel} client:load />
          )}
        </div>
      </article>
    )
  }
</BaseLayout>

<style>
  .case-study {
    padding-block: clamp(var(--space-7), 10vw, var(--space-9));
  }

  .project-intro {
    --stack-space: var(--space-5);

    max-inline-size: 58rem;
    padding-block-end: clamp(var(--space-8), 12vw, 8rem);
  }

  .eyebrow,
  h1,
  h2,
  p {
    margin-block: 0;
  }

  .eyebrow {
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--font-size-heading-lg);
  }

  h2 {
    font-size: var(--font-size-heading-sm);
  }

  .project-summary {
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
  }

  .back-link {
    inline-size: fit-content;
    min-block-size: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    font-weight: var(--font-weight-medium);
  }

  .case-study__sections {
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .shell-section {
    padding-block: clamp(var(--space-6), 7vw, var(--space-8));
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .shell-section p {
    color: var(--color-text-muted);
  }
</style>
