---
import { getCollection } from 'astro:content';

import DuckyArenaCaseStudy from '@components/DuckyArenaCaseStudy.astro';
import DevDataCaseStudy from '@components/DevDataCaseStudy.astro';
import QuestBoardCaseStudy from '@components/QuestBoardCaseStudy.astro';
import SiteHeader from '@components/SiteHeader.astro';
import { getProjectInspectionModel } from '@content/project-inspections';
import { getDuckyArenaContent } from '@content/projects/duckyarena';
import { getQuestBoardContent } from '@content/projects/questboard';
import { projects, type ProjectId } from '@content/projects';
import { locales, type Locale } from '@i18n/config';
import { getLocalizedPath } from '@i18n/routes';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getProjectEditorialEntry } from '@lib/projects';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    Object.values(projects).map((project) => ({
      params: { lang: locale, slug: project.slug },
      props: { locale, projectId: project.id },
    })),
  );
}

interface Props {
  locale: Locale;
  projectId: ProjectId;
}

const { locale, projectId } = Astro.props;
const t = useTranslations(locale);
const projectEntries = await getCollection('projects');
const projectEntry = getProjectEditorialEntry(
  projectEntries,
  projectId,
  locale,
);

if (!projectEntry) {
  throw new Error(`Missing ${locale} content for project ${projectId}`);
}

const homePath = getLocalizedPath(locale);
const devDataPath = getLocalizedPath(locale, '/projects/devdata-generator');
const duckyArenaPath = getLocalizedPath(locale, '/projects/duckyarena');
const questBoardPath = getLocalizedPath(locale, '/projects/questboard');
const isDuckyArena = projectId === 'duckyarena';
const isQuestBoard = projectId === 'questboard';
const navigationCopy =
  locale === 'en'
    ? {
        label: 'Case study navigation',
        home: 'Home',
        backToTop: 'Back to top',
      }
    : {
        label: 'Navegación del caso de estudio',
        home: 'Inicio',
        backToTop: 'Volver arriba',
      };
const duckyArenaContent = isDuckyArena
  ? getDuckyArenaContent(locale)
  : undefined;
const questBoardContent = isQuestBoard
  ? getQuestBoardContent(locale)
  : undefined;
const pageTitle =
  questBoardContent?.metadata.title ??
  duckyArenaContent?.metadata.title ??
  t.caseStudy.metadata.title;
const pageDescription =
  questBoardContent?.metadata.description ??
  duckyArenaContent?.metadata.description ??
  t.caseStudy.metadata.description;
const inspectionModel =
  isDuckyArena || isQuestBoard
    ? undefined
    : getProjectInspectionModel(projectId, locale);
---

<BaseLayout locale={locale} title={pageTitle} description={pageDescription}>
  <SiteHeader slot="header" locale={locale} pathname={Astro.url.pathname} />

  {
    questBoardContent ? (
      <QuestBoardCaseStudy
        content={questBoardContent}
        homePath={homePath}
        bottomNavigation={{
          ...navigationCopy,
          nextProject: 'DuckyArena',
          nextProjectPath: duckyArenaPath,
        }}
      />
    ) : duckyArenaContent ? (
      <DuckyArenaCaseStudy
        content={duckyArenaContent}
        homePath={homePath}
        bottomNavigation={{
          ...navigationCopy,
          nextProject: 'DevData Generator',
          nextProjectPath: devDataPath,
        }}
      />
    ) : (
      inspectionModel && (
        <DevDataCaseStudy
          title={projectEntry.data.title}
          summary={projectEntry.data.summary}
          homePath={homePath}
          copy={t.caseStudy}
          model={inspectionModel}
          bottomNavigation={{
            ...navigationCopy,
            nextProject: 'QuestBoard',
            nextProjectPath: questBoardPath,
          }}
        />
      )
    )
  }
</BaseLayout>
