---
import HomeProjectPreview from '@components/HomeProjectPreview.astro';
import DuckyArenaHomePreview from '@components/DuckyArenaHomePreview.astro';
import SiteHeader from '@components/SiteHeader.astro';
import { getProjectInspectionModel } from '@content/project-inspections';
import { getDuckyArenaContent } from '@content/projects/duckyarena';
import {
  getProfessionalProfile,
  professionalLinks,
  publicCvPath,
} from '@content/professional-profile';
import { locales, type Locale } from '@i18n/config';
import { getLocalizedPath } from '@i18n/routes';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import { requireProject } from '@lib/projects';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = getProfessionalProfile(locale);
const project = requireProject('devdata-generator');
const duckyArenaProject = requireProject('duckyarena');
const duckyArenaContent = getDuckyArenaContent(locale);
const projectInspection = getProjectInspectionModel(
  'devdata-generator',
  locale,
);
const projectPath = getLocalizedPath(locale, `/projects/${project.slug}`);
const duckyArenaPath = getLocalizedPath(
  locale,
  `/projects/${duckyArenaProject.slug}`,
);
---

<BaseLayout
  locale={locale}
  title={profile.metadata.title}
  description={profile.metadata.description}
>
  <SiteHeader slot="header" locale={locale} pathname={Astro.url.pathname} />

  <div class="container home">
    <section class="hero stack" aria-labelledby="home-heading">
      <p class="eyebrow">{profile.hero.eyebrow}</p>
      <h1 id="home-heading">{profile.hero.heading}</h1>
      <p class="measure introduction">{profile.hero.introduction}</p>
      <div class="hero-actions">
        <a class="action-link action-link--primary" href="#featured-work">
          {profile.hero.workCta}
        </a>
        <a class="action-link" href="#contact">{profile.hero.contactCta}</a>
      </div>
    </section>

    <HomeProjectPreview
      copy={t.home.featuredProject}
      href={projectPath}
      productVisual={projectInspection.productVisual}
    />

    <DuckyArenaHomePreview content={duckyArenaContent} href={duckyArenaPath} />

    <section id="about" class="profile-section" aria-labelledby="about-heading">
      <div class="section-heading">
        <p class="section-index">01</p>
        <h2 id="about-heading">{profile.about.heading}</h2>
      </div>
      <div class="profile-section__body measure stack">
        {profile.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section
      id="capabilities"
      class="profile-section"
      aria-labelledby="capabilities-heading"
    >
      <div class="section-heading">
        <p class="section-index">02</p>
        <h2 id="capabilities-heading">{profile.capabilities.heading}</h2>
      </div>
      <div class="profile-section__body stack">
        <dl class="capability-groups">
          {
            profile.capabilities.groups.map((group) => (
              <div>
                <dt>{group.title}</dt>
                <dd>
                  <ul class="inline-list" aria-label={group.title}>
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="secondary-copy">{profile.capabilities.secondary}</p>
      </div>
    </section>

    <section
      id="experience"
      class="profile-section"
      aria-labelledby="experience-heading"
    >
      <div class="section-heading">
        <p class="section-index">03</p>
        <h2 id="experience-heading">{profile.experience.heading}</h2>
      </div>
      <ol class="profile-section__body entry-list">
        {
          profile.experience.entries.map((entry) => (
            <li>
              <article>
                <header>
                  <h3>{entry.company}</h3>
                  <p>{entry.role}</p>
                </header>
                <p class="entry-meta">{entry.meta}</p>
                <p>{entry.summary}</p>
              </article>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      id="education"
      class="profile-section"
      aria-labelledby="education-heading"
    >
      <div class="section-heading">
        <p class="section-index">04</p>
        <h2 id="education-heading">{profile.education.heading}</h2>
      </div>
      <ul class="profile-section__body entry-list education-list">
        {
          profile.education.entries.map((entry) => (
            <li>
              <article>
                <h3>{entry.title}</h3>
                <p>{entry.institution}</p>
                <p class="entry-meta">{entry.dates}</p>
                {'href' in entry ? (
                  <a
                    class="text-link"
                    href={entry.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={entry.accessibleLabel}
                  >
                    {entry.status}
                  </a>
                ) : (
                  <p class="entry-status">{entry.status}</p>
                )}
              </article>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      id="contact"
      class="profile-section contact-section"
      aria-labelledby="contact-heading"
    >
      <div class="section-heading">
        <p class="section-index">05</p>
        <h2 id="contact-heading">{profile.contact.heading}</h2>
      </div>
      <div class="profile-section__body stack">
        <p class="measure contact-introduction">
          {profile.contact.introduction}
        </p>
        <ul class="contact-links">
          <li>
            <span>{profile.contact.emailLabel}</span>
            <a href={`mailto:${professionalLinks.email}`}>
              {professionalLinks.email}
            </a>
          </li>
          <li>
            <a
              href={professionalLinks.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              {profile.contact.githubLabel}
            </a>
          </li>
          <li>
            <a
              href={professionalLinks.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              {profile.contact.linkedinLabel}
            </a>
          </li>
          <li>
            <a href={publicCvPath} download>{profile.contact.cvLabel}</a>
          </li>
        </ul>
      </div>
    </section>
  </div>

  <footer slot="footer" class="site-footer">
    <div class="container">
      <p>{profile.footer}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  .home {
    padding-block: clamp(var(--space-7), 10vw, var(--space-9));
  }

  .hero {
    --stack-space: var(--space-5);

    max-inline-size: 58rem;
    padding-block-end: clamp(var(--space-8), 14vw, 9rem);
  }

  .eyebrow,
  .section-index {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  h1,
  p {
    margin-block: 0;
  }

  h1 {
    max-inline-size: 17ch;
    font-size: var(--font-size-heading-lg);
  }

  .introduction {
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
  }

  .hero-actions,
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .action-link,
  .text-link,
  .contact-links a {
    inline-size: fit-content;
    min-block-size: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    font-weight: var(--font-weight-medium);
  }

  .action-link {
    padding-inline: var(--space-4);
    border: var(--border-width) solid var(--color-border-strong);
    text-decoration: none;
  }

  .action-link--primary {
    background: var(--color-interactive);
    color: var(--color-surface);
  }

  .profile-section {
    display: grid;
    grid-template-columns: minmax(10rem, 0.65fr) minmax(0, 1.35fr);
    gap: var(--space-6) clamp(var(--space-6), 7vw, var(--space-9));
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .section-heading {
    align-self: start;
    padding-inline-start: var(--space-4);
    border-inline-start: var(--border-width-strong) solid
      var(--color-border-strong);
  }

  .section-heading h2,
  .profile-section p,
  .profile-section h3,
  .profile-section dl,
  .profile-section dd {
    margin: 0;
  }

  .section-heading h2 {
    margin-block-start: var(--space-2);
    font-size: var(--font-size-heading-sm);
  }

  .profile-section__body {
    min-inline-size: 0;
  }

  .profile-section__body.stack {
    --stack-space: var(--space-5);
  }

  .capability-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .capability-groups > div,
  .entry-list > li {
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .capability-groups dt {
    font-weight: var(--font-weight-bold);
  }

  .capability-groups dd {
    margin-block-start: var(--space-3);
  }

  .inline-list,
  .entry-list,
  .contact-links {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .inline-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    color: var(--color-text-muted);
  }

  .inline-list li:not(:last-child)::after {
    content: '·';
    margin-inline-start: var(--space-3);
  }

  .secondary-copy,
  .entry-meta {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .entry-list {
    display: grid;
    gap: var(--space-6);
  }

  .entry-list article {
    display: grid;
    grid-template-columns: minmax(12rem, 0.75fr) minmax(9rem, 0.55fr) minmax(
        16rem,
        1fr
      );
    gap: var(--space-2) var(--space-6);
    align-items: start;
  }

  .entry-list h3 {
    font-size: var(--font-size-body);
  }

  .entry-list header p,
  .entry-status {
    margin-block-start: var(--space-1);
    color: var(--color-text-muted);
  }

  .education-list article {
    grid-template-columns: minmax(16rem, 1fr) minmax(10rem, 0.55fr) minmax(
        7rem,
        0.35fr
      );
  }

  .education-list article > :last-child {
    grid-column: 3;
  }

  .contact-section {
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .contact-introduction {
    font-size: var(--font-size-lead);
  }

  .contact-links a {
    padding-inline: var(--space-3);
  }

  .contact-links li {
    display: flex;
    flex-direction: column;
  }

  .contact-links span {
    padding-inline: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .site-footer {
    padding-block: var(--space-6);
    border-block-start: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .site-footer p {
    margin: 0;
  }

  @media (width < 64rem) {
    .capability-groups {
      grid-template-columns: 1fr;
    }

    .entry-list article,
    .education-list article {
      grid-template-columns: 1fr;
    }

    .education-list article > :last-child {
      grid-column: auto;
    }
  }

  @media (width < 48rem) {
    .profile-section {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
