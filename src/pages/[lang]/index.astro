---
import { getCollection } from 'astro:content';

import SiteHeader from '@components/SiteHeader.astro';
import { locales, type Locale } from '@i18n/config';
import { getLocalizedPath } from '@i18n/routes';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getProjectEditorialEntry, requireProject } from '@lib/projects';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const project = requireProject('devdata-generator');
const projectEntries = await getCollection('projects');
const featuredProject = getProjectEditorialEntry(
  projectEntries,
  'devdata-generator',
  locale,
);

if (!featuredProject) {
  throw new Error(`Missing ${locale} content for project ${project.id}`);
}

const projectPath = getLocalizedPath(locale, `/projects/${project.slug}`);
---

<BaseLayout
  locale={locale}
  title={t.home.title}
  description={t.home.description}
>
  <SiteHeader slot="header" locale={locale} pathname={Astro.url.pathname} />

  <div class="container home">
    <section class="hero stack" aria-labelledby="home-heading">
      <p class="eyebrow">{t.home.eyebrow}</p>
      <h1 id="home-heading">{t.home.heading}</h1>
      <p class="measure introduction">{t.home.introduction}</p>
      <a class="text-link" href="#featured-work">{t.home.projectCta}</a>
    </section>

    <section
      id="featured-work"
      class="featured stack"
      aria-labelledby="featured-heading"
    >
      <p class="eyebrow">{t.home.featuredWorkLabel}</p>
      <div class="featured__content stack">
        <h2 id="featured-heading">{featuredProject.data.title}</h2>
        <p class="measure">{featuredProject.data.summary}</p>
        <a class="text-link" href={projectPath}>{t.home.projectLink}</a>
      </div>
    </section>
  </div>

  <footer slot="footer" class="site-footer">
    <div class="container">
      <p>{t.home.footer}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  .home {
    padding-block: clamp(var(--space-7), 10vw, var(--space-9));
  }

  .hero {
    --stack-space: var(--space-5);

    max-inline-size: 58rem;
    padding-block-end: clamp(var(--space-8), 14vw, 9rem);
  }

  .eyebrow {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-block: 0;
  }

  h1 {
    max-inline-size: 17ch;
    font-size: var(--font-size-heading-lg);
  }

  h2 {
    font-size: var(--font-size-heading-md);
  }

  .introduction {
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
  }

  .text-link {
    inline-size: fit-content;
    min-block-size: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    font-weight: var(--font-weight-medium);
  }

  .featured {
    --stack-space: var(--space-5);

    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .featured__content {
    --stack-space: var(--space-4);
  }

  .site-footer {
    padding-block: var(--space-6);
    border-block-start: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .site-footer p {
    margin: 0;
  }

  @media (width >= 48rem) {
    .featured {
      display: grid;
      grid-template-columns: minmax(10rem, 1fr) minmax(0, 2fr);
      gap: var(--space-7);
      align-items: start;
    }
  }
</style>
