---
import HomeProjectPreview from '@components/HomeProjectPreview.astro';
import ContactIcon from '@components/ContactIcon.astro';
import DuckyArenaHomePreview from '@components/DuckyArenaHomePreview.astro';
import HomeHero from '@components/HomeHero.astro';
import QuestBoardHomePreview from '@components/QuestBoardHomePreview.astro';
import SiteFooter from '@components/SiteFooter.astro';
import SiteHeader from '@components/SiteHeader.astro';
import { getProjectInspectionModel } from '@content/project-inspections';
import { getDuckyArenaContent } from '@content/projects/duckyarena';
import { getQuestBoardContent } from '@content/projects/questboard';
import {
  getProfessionalProfile,
  professionalLinks,
  publicCvPath,
} from '@content/professional-profile';
import { locales, type Locale } from '@i18n/config';
import { getLocalizedPath } from '@i18n/routes';
import { useTranslations } from '@i18n/ui';
import BaseLayout from '@layouts/BaseLayout.astro';
import { requireProject } from '@lib/projects';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = getProfessionalProfile(locale);
const project = requireProject('devdata-generator');
const duckyArenaProject = requireProject('duckyarena');
const questBoardProject = requireProject('questboard');
const duckyArenaContent = getDuckyArenaContent(locale);
const questBoardContent = getQuestBoardContent(locale);
const projectInspection = getProjectInspectionModel(
  'devdata-generator',
  locale,
);
const projectPath = getLocalizedPath(locale, `/projects/${project.slug}`);
const duckyArenaPath = getLocalizedPath(
  locale,
  `/projects/${duckyArenaProject.slug}`,
);
const questBoardPath = getLocalizedPath(
  locale,
  `/projects/${questBoardProject.slug}`,
);
const backToTopLabel = locale === 'en' ? 'Back to top' : 'Volver arriba';
---

<BaseLayout
  locale={locale}
  title={profile.metadata.title}
  description={profile.metadata.description}
>
  <SiteHeader slot="header" locale={locale} pathname={Astro.url.pathname} />

  <div id="top" class="container home">
    <HomeHero
      locale={locale}
      eyebrow={profile.hero.eyebrow}
      name={profile.identity}
      heading={profile.hero.heading}
      introduction={profile.hero.introduction}
      workCta={profile.hero.workCta}
      cvCta={profile.hero.cvCta}
    />

    <div id="work" class="work-region">
      <QuestBoardHomePreview
        content={questBoardContent}
        href={questBoardPath}
      />

      <DuckyArenaHomePreview
        content={duckyArenaContent}
        href={duckyArenaPath}
      />

      <HomeProjectPreview
        copy={t.home.featuredProject}
        href={projectPath}
        productVisual={projectInspection.productVisual}
      />
    </div>

    <section
      id="stack"
      class="profile-section"
      aria-labelledby="capabilities-heading"
    >
      <div class="section-heading">
        <p class="section-index">01</p>
        <h2 id="capabilities-heading">{profile.capabilities.heading}</h2>
      </div>
      <div class="profile-section__body stack">
        <p class="capabilities-introduction">
          {profile.capabilities.introduction}
        </p>
        <dl class="capability-groups">
          {
            profile.capabilities.groups.map((group) => (
              <div>
                <dt>{group.title}</dt>
                <dd>
                  <p class="capability-description">{group.description}</p>
                  <ul class="inline-list" aria-label={group.title}>
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <p class="capability-evidence">{group.evidence}</p>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section id="about" class="profile-section" aria-labelledby="about-heading">
      <div class="section-heading">
        <p class="section-index">02</p>
        <h2 id="about-heading">{profile.about.heading}</h2>
      </div>
      <div class="profile-section__body measure stack">
        {profile.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section
      id="experience"
      class="profile-section"
      aria-labelledby="experience-heading"
    >
      <div class="section-heading">
        <p class="section-index">03</p>
        <h2 id="experience-heading">{profile.experience.heading}</h2>
      </div>
      <ol class="profile-section__body entry-list">
        {
          profile.experience.entries.map((entry) => (
            <li>
              <article>
                <header>
                  <h3>{entry.company}</h3>
                  <p>{entry.role}</p>
                </header>
                <p class="entry-meta">{entry.meta}</p>
                <p>{entry.summary}</p>
              </article>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      id="education"
      class="profile-section"
      aria-labelledby="education-heading"
    >
      <div class="section-heading">
        <p class="section-index">04</p>
        <h2 id="education-heading">{profile.education.heading}</h2>
      </div>
      <ul class="profile-section__body entry-list education-list">
        {
          profile.education.entries.map((entry) => (
            <li>
              <article>
                <h3>{entry.title}</h3>
                <p>{entry.institution}</p>
                <p class="entry-meta">{entry.dates}</p>
                {'href' in entry ? (
                  <a
                    class="text-link"
                    href={entry.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={entry.accessibleLabel}
                  >
                    {entry.status}
                  </a>
                ) : (
                  <p class="entry-status">{entry.status}</p>
                )}
              </article>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="cv" class="profile-section" aria-labelledby="cv-heading">
      <div class="section-heading">
        <p class="section-index">05</p>
        <h2 id="cv-heading">CV</h2>
      </div>
      <div class="profile-section__body">
        <a class="action-link" href={publicCvPath} download>
          <ContactIcon type="download" />
          {profile.contact.cvLabel}
        </a>
      </div>
    </section>

    <section
      id="contact"
      class="profile-section contact-section"
      aria-labelledby="contact-heading"
    >
      <div class="section-heading">
        <p class="section-index">06</p>
        <h2 id="contact-heading">{profile.contact.heading}</h2>
      </div>
      <div class="profile-section__body stack">
        <p class="measure contact-introduction">
          {profile.contact.introduction}
        </p>
        <ul class="contact-links">
          <li>
            <a href={`mailto:${professionalLinks.email}`}>
              <ContactIcon type="email" />
              {profile.contact.emailLabel}
            </a>
          </li>
          <li>
            <a
              href={professionalLinks.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              <ContactIcon type="github" />
              {profile.contact.githubLabel}
            </a>
          </li>
          <li>
            <a
              href={professionalLinks.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              <ContactIcon type="linkedin" />
              {profile.contact.linkedinLabel}
            </a>
          </li>
        </ul>
      </div>
    </section>

    <a class="back-to-top" href="#top">
      <span aria-hidden="true">↑</span>{backToTopLabel}
    </a>
  </div>

  <SiteFooter slot="footer" locale={locale} />
</BaseLayout>

<style>
  .home {
    padding-block: 0 clamp(var(--space-7), 10vw, var(--space-9));
  }

  .work-region {
    min-inline-size: 0;
  }

  .eyebrow,
  .section-index {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  p {
    margin-block: 0;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .action-link,
  .text-link,
  .contact-links a {
    inline-size: fit-content;
    min-block-size: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    font-weight: var(--font-weight-medium);
  }

  .action-link {
    gap: var(--space-2);
    padding-inline: var(--space-4);
    border: var(--border-width) solid var(--color-border-strong);
    text-decoration: none;
  }

  .action-link--primary {
    background: var(--color-interactive);
    color: var(--color-surface);
  }

  .profile-section {
    display: grid;
    grid-template-columns: minmax(10rem, 0.65fr) minmax(0, 1.35fr);
    gap: var(--space-6) clamp(var(--space-6), 7vw, var(--space-9));
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .section-heading {
    align-self: start;
    padding-inline-start: var(--space-4);
    border-inline-start: var(--border-width-strong) solid
      var(--color-border-strong);
  }

  .section-heading h2,
  .profile-section p,
  .profile-section h3,
  .profile-section dl,
  .profile-section dd {
    margin: 0;
  }

  .section-heading h2 {
    margin-block-start: var(--space-2);
    font-size: var(--font-size-heading-sm);
  }

  .profile-section__body {
    min-inline-size: 0;
  }

  .profile-section__body.stack {
    --stack-space: var(--space-5);
  }

  .capability-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(var(--space-5), 4vw, var(--space-7));
  }

  .capability-groups > div,
  .entry-list > li {
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .capability-groups dt {
    color: var(--color-accent-secondary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .capability-groups dd {
    margin-block-start: var(--space-3);
  }

  .inline-list,
  .entry-list,
  .contact-links {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .inline-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    color: var(--color-text-muted);
  }

  .capabilities-introduction {
    max-inline-size: var(--content-measure);
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
  }

  .capability-description {
    min-block-size: 4.5em;
    color: var(--color-text);
  }

  .capability-evidence {
    margin-block-start: var(--space-4) !important;
    padding-block-start: var(--space-3);
    border-block-start: var(--border-width) solid var(--color-border);
    color: var(--color-text-soft);
    font-size: var(--font-size-sm);
  }

  .inline-list li:not(:last-child)::after {
    content: '·';
    margin-inline-start: var(--space-3);
  }

  .secondary-copy,
  .entry-meta {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .entry-list {
    display: grid;
    gap: var(--space-6);
  }

  .entry-list article {
    display: grid;
    grid-template-columns: minmax(12rem, 0.75fr) minmax(9rem, 0.55fr) minmax(
        16rem,
        1fr
      );
    gap: var(--space-2) var(--space-6);
    align-items: start;
  }

  .entry-list h3 {
    font-size: var(--font-size-body);
  }

  .entry-list header p,
  .entry-status {
    margin-block-start: var(--space-1);
    color: var(--color-text-muted);
  }

  .education-list article {
    grid-template-columns: minmax(16rem, 1fr) minmax(10rem, 0.55fr) minmax(
        7rem,
        0.35fr
      );
  }

  .education-list article > :last-child {
    grid-column: 3;
  }

  .contact-section {
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .contact-introduction {
    font-size: var(--font-size-lead);
  }

  .contact-links a {
    gap: var(--space-2);
    padding-inline: var(--space-3);
  }

  .contact-links li {
    display: contents;
  }

  .back-to-top {
    min-block-size: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--font-size-body);
  }

  @media (width <= 64rem) {
    .capability-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .capability-groups > div:last-child {
      grid-column: 1 / -1;
    }

    .capability-description {
      min-block-size: 0;
    }

    .entry-list article,
    .education-list article {
      grid-template-columns: 1fr;
    }

    .education-list article > :last-child {
      grid-column: auto;
    }
  }

  @media (width < 48rem) {
    .profile-section {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .capability-groups {
      grid-template-columns: 1fr;
    }

    .capability-groups > div:last-child {
      grid-column: auto;
    }
  }
</style>
