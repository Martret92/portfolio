---
const productionOrigin = Astro.site ?? new URL('https://jaimemartret.com');
const englishUrl = new URL('/en', productionOrigin);
const spanishUrl = new URL('/es', productionOrigin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content="0;url=/en" />
    <title>Jaime Martret — Professional Portfolio</title>
    <link rel="canonical" href={englishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body>
    <main>
      <h1>Jaime Martret — Professional Portfolio</h1>
      <p>Continue to the English portfolio.</p>

      <a href="/en">Continue to English</a>
    </main>
  </body>
</html>
