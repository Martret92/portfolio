---
import type { getDuckyArenaContent } from '@content/projects/duckyarena';

interface Props {
  content: ReturnType<typeof getDuckyArenaContent>;
  homePath: string;
  bottomNavigation: {
    label: string;
    home: string;
    nextProject: string;
    nextProjectPath: string;
    backToTop: string;
  };
}

const { content, homePath, bottomNavigation } = Astro.props;
const { images, screenshots } = content;
---

<article id="top" class="ducky-case-study container" data-duckyarena-case-study>
  <header class="project-hero stack">
    <p class="eyebrow">{content.hero.eyebrow}</p>
    <h1>{content.hero.heading}</h1>
    <p class="positioning measure">{content.hero.positioning}</p>
    <p class="introduction measure">{content.hero.introduction}</p>
    <ul class="stack-list" aria-label={content.hero.stackLabel}>
      {
        content.stack.map((technology) => (
          <li>
            <code>{technology}</code>
          </li>
        ))
      }
    </ul>
    <div class="hero-links">
      <a href={homePath}>{content.hero.backHome}</a>
      <a href={content.repository} target="_blank" rel="noopener noreferrer">
        {content.repositoryCta}<span aria-hidden="true">↗</span>
      </a>
    </div>
    <figure class="evidence-figure evidence-figure--hero">
      <img
        src={images.combat.src}
        width={images.combat.width}
        height={images.combat.height}
        alt={screenshots.combat.alt}
        decoding="async"
      />
      <figcaption>{screenshots.combat.caption}</figcaption>
    </figure>
  </header>

  <section class="case-section" aria-labelledby="overview-heading">
    <div class="section-label">
      <span>01</span><h2 id="overview-heading">{content.overview.heading}</h2>
    </div>
    <div class="section-content stack">
      {
        content.overview.paragraphs.map((paragraph) => (
          <p class="measure">{paragraph}</p>
        ))
      }
      <figure class="evidence-figure">
        <img
          src={images.characterSelect.src}
          width={images.characterSelect.width}
          height={images.characterSelect.height}
          alt={screenshots.characterSelect.alt}
          loading="lazy"
          decoding="async"
        />
        <figcaption>{screenshots.characterSelect.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="case-section" aria-labelledby="challenge-heading">
    <div class="section-label">
      <span>02</span><h2 id="challenge-heading">{content.challenge.heading}</h2>
    </div>
    <div class="section-content stack">
      <p class="measure">{content.challenge.challenge}</p>
      <p class="measure">{content.challenge.solution}</p>
    </div>
  </section>

  <section class="case-section" aria-labelledby="gameplay-heading">
    <div class="section-label">
      <span>03</span><h2 id="gameplay-heading">{content.gameplay.heading}</h2>
    </div>
    <div class="section-content stack">
      <p class="measure">{content.gameplay.copy}</p>
      <ol class="flow-list" aria-label={content.gameplay.flowLabel}>
        {content.gameplay.steps.map((step) => <li>{step}</li>)}
      </ol>
      <div class="evidence-pair">
        <figure class="evidence-figure">
          <img
            src={images.laneSelection.src}
            width={images.laneSelection.width}
            height={images.laneSelection.height}
            alt={screenshots.laneSelection.alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{screenshots.laneSelection.caption}</figcaption>
        </figure>
        <figure class="evidence-figure">
          <img
            src={images.matchupReveal.src}
            width={images.matchupReveal.width}
            height={images.matchupReveal.height}
            alt={screenshots.matchupReveal.alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{screenshots.matchupReveal.caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="case-section" aria-labelledby="architecture-heading">
    <div class="section-label">
      <span>04</span><h2 id="architecture-heading">
        {content.architecture.heading}
      </h2>
    </div>
    <div class="section-content stack">
      <p class="measure">{content.architecture.copy}</p>
      <ol class="architecture-flow" aria-label={content.architecture.flowLabel}>
        {
          content.architecture.layers.map((layer) => (
            <li>
              <>
                <code>{layer.name}</code>
                <span>{layer.detail}</span>
              </>
            </li>
          ))
        }
      </ol>
      <ul class="signal-list">
        {content.architecture.signals.map((signal) => <li>{signal}</li>)}
      </ul>
    </div>
  </section>

  <section class="case-section" aria-labelledby="contribution-heading">
    <div class="section-label">
      <span>05</span><h2 id="contribution-heading">
        {content.contribution.heading}
      </h2>
    </div>
    <div class="section-content stack">
      <p class="measure">{content.contribution.introduction}</p>
      <div class="editorial-grid">
        {
          content.contribution.items.map((item) => (
            <article>
              <>
                <h3>{item.heading}</h3>
                <p>{item.copy}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="case-section" aria-labelledby="decisions-heading">
    <div class="section-label">
      <span>06</span><h2 id="decisions-heading">{content.decisions.heading}</h2>
    </div>
    <div class="section-content decision-grid">
      {
        content.decisions.items.map((item) => (
          <article>
            <h3>{item.heading}</h3>
            <p>
              <strong>{content.decisions.decisionLabel}:</strong>{' '}
              {item.decision}
            </p>
            <p>
              <strong>{content.decisions.tradeoffLabel}:</strong>{' '}
              {item.tradeoff}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="case-section" aria-labelledby="visual-heading">
    <div class="section-label">
      <span>07</span><h2 id="visual-heading">{content.visual.heading}</h2>
    </div>
    <div class="section-content stack">
      {
        content.visual.paragraphs.map((paragraph) => (
          <p class="measure">{paragraph}</p>
        ))
      }
    </div>
  </section>

  <section class="case-section" aria-labelledby="quality-heading">
    <div class="section-label">
      <span>08</span><h2 id="quality-heading">{content.quality.heading}</h2>
    </div>
    <div class="section-content stack">
      <p class="measure">{content.quality.copy}</p>
      <ul class="evidence-list">
        {content.quality.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="case-section" aria-labelledby="outcomes-heading">
    <div class="section-label">
      <span>09</span><h2 id="outcomes-heading">{content.outcomes.heading}</h2>
    </div>
    <div class="section-content stack">
      <div class="outcome-grid">
        <div>
          <h3>{content.outcomes.outcomesLabel}</h3><ul>
            {content.outcomes.outcomes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h3>{content.outcomes.limitsLabel}</h3><ul>
            {content.outcomes.limits.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <figure class="evidence-figure">
        <img
          src={images.result.src}
          width={images.result.width}
          height={images.result.height}
          alt={screenshots.result.alt}
          loading="lazy"
          decoding="async"
        />
        <figcaption>{screenshots.result.caption}</figcaption>
      </figure>
    </div>
  </section>

  <footer class="project-footer">
    <a href={content.repository} target="_blank" rel="noopener noreferrer">
      {content.repositoryCta}<span aria-hidden="true">↗</span>
    </a>
    <nav aria-label={bottomNavigation.label}>
      <a href={homePath}
        ><span aria-hidden="true">←</span>{bottomNavigation.home}</a
      >
      <a href={bottomNavigation.nextProjectPath}
        >{bottomNavigation.nextProject}<span aria-hidden="true">→</span></a
      >
      <a href="#top"
        ><span aria-hidden="true">↑</span>{bottomNavigation.backToTop}</a
      >
    </nav>
  </footer>
</article>

<style>
  .ducky-case-study {
    padding-block: clamp(var(--space-7), 9vw, var(--space-9));
  }
  .project-hero {
    --stack-space: var(--space-5);
    padding-block-end: clamp(var(--space-8), 10vw, 8rem);
  }
  .project-hero > :not(.evidence-figure) {
    max-inline-size: 62rem;
  }
  .eyebrow,
  .section-label > span {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }
  h1,
  h2,
  h3,
  p,
  figure {
    margin-block: 0;
  }
  h1 {
    font-size: var(--font-size-heading-lg);
  }
  h2 {
    font-size: var(--font-size-heading-sm);
  }
  h3 {
    font-size: var(--font-size-body);
  }
  .positioning {
    font-size: var(--font-size-lead);
  }
  .introduction,
  figcaption,
  .editorial-grid p,
  .decision-grid p {
    color: var(--color-text-muted);
  }
  .stack-list,
  .flow-list,
  .architecture-flow,
  .signal-list,
  .evidence-list,
  .outcome-grid ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero-links a,
  .project-footer a {
    min-block-size: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    padding-inline: var(--space-3);
    border-inline-start: var(--border-width-strong) solid
      var(--color-border-strong);
    font-weight: var(--font-weight-medium);
  }
  .hero-links span,
  .project-footer span {
    margin-inline-start: var(--space-2);
  }
  .case-section {
    display: grid;
    grid-template-columns: minmax(12rem, 0.42fr) minmax(0, 1.58fr);
    gap: var(--space-6) clamp(var(--space-6), 7vw, var(--space-9));
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    border-block-start: var(--border-width) solid var(--color-border);
  }
  .section-label {
    align-self: start;
    padding-inline-start: var(--space-4);
    border-inline-start: var(--border-width-strong) solid
      var(--color-border-strong);
  }
  .section-label h2 {
    margin-block-start: var(--space-2);
  }
  .section-content {
    --stack-space: var(--space-6);
    min-inline-size: 0;
  }
  .evidence-figure {
    min-inline-size: 0;
    padding-block-start: var(--space-3);
    border-block-start: var(--border-width) solid var(--color-border);
  }
  .evidence-figure--hero {
    margin-block-start: clamp(var(--space-6), 6vw, var(--space-8));
  }
  .evidence-figure img {
    inline-size: 100%;
    block-size: auto;
    display: block;
    border: var(--border-width) solid var(--color-border-strong);
  }
  figcaption {
    margin-block-start: var(--space-3);
    font-size: var(--font-size-sm);
  }
  .flow-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
    counter-reset: flow;
  }
  .flow-list li {
    min-inline-size: 0;
    padding: var(--space-3);
    border-inline-start: var(--border-width-strong) solid
      var(--color-border-strong);
    background: var(--color-surface-subtle);
  }
  .evidence-pair,
  .editorial-grid,
  .decision-grid,
  .outcome-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .architecture-flow {
    display: grid;
  }
  .architecture-flow li {
    min-block-size: var(--touch-target-min);
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 0.65fr);
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border-inline-start: var(--border-width-strong) solid
      var(--color-border-strong);
    border-block-end: var(--border-width) solid var(--color-border);
  }
  .architecture-flow span,
  .signal-list,
  .evidence-list {
    color: var(--color-text-muted);
  }
  .signal-list,
  .evidence-list {
    display: grid;
    gap: var(--space-2);
  }
  .signal-list li,
  .evidence-list li,
  .outcome-grid li {
    padding-inline-start: var(--space-4);
    border-inline-start: var(--border-width) solid var(--color-border);
  }
  .editorial-grid article,
  .decision-grid article,
  .outcome-grid > div {
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border);
  }
  .editorial-grid p,
  .decision-grid p {
    margin-block-start: var(--space-3);
  }
  .outcome-grid ul {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
  }
  .project-footer {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-block-start: var(--border-width) solid var(--color-border);
  }
  .project-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border);
  }
  .project-footer nav a {
    color: var(--color-text-muted);
  }
  @media (width >= 64rem) {
    .project-footer nav {
      display: grid;
      grid-template-columns: 1fr auto auto;
    }
  }
  @media (width < 64rem) {
    .flow-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width < 48rem) {
    .case-section,
    .evidence-pair,
    .editorial-grid,
    .decision-grid,
    .outcome-grid {
      grid-template-columns: 1fr;
    }
    .flow-list {
      grid-template-columns: 1fr;
    }
    .architecture-flow li {
      grid-template-columns: 1fr;
    }
  }
</style>
