---
import type { getDuckyArenaContent } from '@content/projects/duckyarena';

interface Props {
  content: ReturnType<typeof getDuckyArenaContent>;
  homePath: string;
}

const { content, homePath } = Astro.props;
const evidence = content.evidence;
---

<article class="ducky-case-study container" data-duckyarena-case-study>
  <header class="project-hero stack">
    <p class="eyebrow">{content.hero.eyebrow}</p>
    <h1>{content.hero.heading}</h1>
    <p class="introduction measure">{content.hero.introduction}</p>
    <div class="hero-links">
      <a href={homePath}>{content.hero.backHome}</a>
      <a href={content.repository} target="_blank" rel="noopener noreferrer">
        {content.repositoryCta}
      </a>
    </div>
  </header>

  <section
    class="context-section case-section"
    aria-labelledby="context-heading"
  >
    <div class="section-label">
      <span>01</span>
      <h2 id="context-heading">{content.context.heading}</h2>
    </div>
    <p class="measure">{content.context.copy}</p>
  </section>

  <section class="case-section" aria-labelledby="contribution-heading">
    <div class="section-label">
      <span>02</span>
      <h2 id="contribution-heading">{content.contribution.heading}</h2>
    </div>
    <div class="measure stack contribution-copy">
      {content.contribution.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section
    class="architecture case-section"
    aria-labelledby="architecture-heading"
  >
    <header class="section-label">
      <span>03</span>
      <h2 id="architecture-heading">{content.architecture.heading}</h2>
    </header>
    <p class="measure architecture-copy">{content.architecture.copy}</p>

    <div class="architecture-composition">
      <ol class="architecture-flow" aria-label={content.architecture.flowLabel}>
        {
          content.architectureLayers.map((layer) => (
            <li>
              <code>{layer}</code>
            </li>
          ))
        }
      </ol>

      <section class="infrastructure" aria-labelledby="infrastructure-heading">
        <h3 id="infrastructure-heading">
          {content.architecture.infrastructureHeading}
        </h3>
        <div class="infrastructure-tree">
          <p><code>{content.architecture.composeLabel}</code></p>
          <ul aria-label={content.architecture.infrastructureLabel}>
            {
              content.infrastructure.map((service) => (
                <li>
                  <code>{service}</code>
                </li>
              ))
            }
          </ul>
        </div>
        <ul class="infrastructure-notes">
          <li>{content.architecture.initialization}</li>
          <li>{content.architecture.healthcheck}</li>
        </ul>
      </section>
    </div>
  </section>

  <section
    class="evidence-section case-section"
    aria-labelledby="evidence-heading"
  >
    <header class="section-label">
      <span>04</span>
      <h2 id="evidence-heading">{content.evidenceHeading}</h2>
    </header>

    <div class="evidence-list">
      <article class="evidence-item">
        <p class="evidence-label">{evidence.separation.label}</p>
        <h3>{evidence.separation.heading}</h3>
        <p class="measure">{evidence.separation.copy}</p>
        <div class="comparison" aria-label={evidence.separation.heading}>
          <div>
            <strong>{evidence.separation.before}</strong>
            <code>controller</code>
            <span>{evidence.separation.http} + {evidence.separation.sql}</span>
          </div>
          <span aria-hidden="true">→</span>
          <div>
            <strong>{evidence.separation.after}</strong>
            <code>controller → model → PostgreSQL</code>
            <span>{evidence.separation.http} / {evidence.separation.sql}</span>
          </div>
        </div>
      </article>

      <article class="evidence-item">
        <p class="evidence-label">{evidence.endpoints.label}</p>
        <h3>{evidence.endpoints.heading}</h3>
        <p class="measure">{evidence.endpoints.copy}</p>
        <ul class="code-list">
          {
            content.endpoints.map((endpoint) => (
              <li>
                <code>{endpoint}</code>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="evidence-item">
        <p class="evidence-label">{evidence.integrity.label}</p>
        <h3>{evidence.integrity.heading}</h3>
        <p class="measure">{evidence.integrity.copy}</p>
        <ul class="code-list">
          {
            content.constraints.map((constraint) => (
              <li>
                <code>{constraint}</code>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="evidence-item">
        <p class="evidence-label">{evidence.middleware.label}</p>
        <h3>{evidence.middleware.heading}</h3>
        <p class="measure">{evidence.middleware.copy}</p>
        <ol class="compact-flow" aria-label={evidence.middleware.heading}>
          {
            evidence.middleware.steps.map((step) => (
              <li>
                <code>{step}</code>
              </li>
            ))
          }
        </ol>
        <p class="limitation measure">{evidence.middleware.limitation}</p>
      </article>

      <article class="evidence-item">
        <p class="evidence-label">{evidence.docker.label}</p>
        <h3>{evidence.docker.heading}</h3>
        <p class="measure">{evidence.docker.copy}</p>
        <div class="docker-evidence">
          <code>docker compose</code>
          <ul>
            <li><code>PostgreSQL → database/init.sql</code></li>
            <li><code>Express backend → DB health check</code></li>
            <li><code>pgAdmin</code></li>
          </ul>
        </div>
      </article>

      <article class="evidence-item evidence-item--featured">
        <p class="evidence-label">{evidence.integration.label}</p>
        <h3>{evidence.integration.heading}</h3>
        <p class="measure">{evidence.integration.copy}</p>
        <ol class="compact-flow" aria-label={evidence.integration.heading}>
          {
            evidence.integration.steps.map((step) => (
              <li>
                <code>{step}</code>
              </li>
            ))
          }
        </ol>
      </article>
    </div>
  </section>

  <div class="closing-sections">
    <section aria-labelledby="status-heading">
      <p class="closing-label">05</p>
      <h2 id="status-heading">{content.status.heading}</h2>
      <p>{content.status.copy}</p>
    </section>
    <section aria-labelledby="continuation-heading">
      <p class="closing-label">06</p>
      <h2 id="continuation-heading">{content.continuation.heading}</h2>
      <p>{content.continuation.copy}</p>
    </section>
  </div>

  <footer class="project-footer">
    <a href={content.repository} target="_blank" rel="noopener noreferrer">
      {content.repositoryCta}<span aria-hidden="true">↗</span>
    </a>
  </footer>
</article>

<style>
  .ducky-case-study {
    padding-block: clamp(var(--space-7), 9vw, var(--space-9));
  }

  .project-hero {
    --stack-space: var(--space-5);

    max-inline-size: 62rem;
    padding-block-end: clamp(var(--space-8), 12vw, 9rem);
  }

  .eyebrow,
  .section-label > span,
  .evidence-label,
  .closing-label {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-block: 0;
  }

  h1 {
    max-inline-size: 19ch;
    font-size: var(--font-size-heading-lg);
  }

  h2 {
    font-size: var(--font-size-heading-sm);
  }

  .introduction {
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-links a,
  .project-footer a {
    min-block-size: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    padding-inline: var(--space-3);
    border-inline-start: var(--border-width-strong) solid
      var(--color-border-strong);
    font-weight: var(--font-weight-medium);
  }

  .case-section {
    display: grid;
    grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1.45fr);
    gap: var(--space-6) clamp(var(--space-6), 8vw, var(--space-9));
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .section-label {
    align-self: start;
    padding-inline-start: var(--space-4);
    border-inline-start: var(--border-width-strong) solid
      var(--color-border-strong);
  }

  .section-label h2 {
    margin-block-start: var(--space-2);
  }

  .contribution-copy {
    --stack-space: var(--space-5);
  }

  .architecture-copy,
  .architecture-composition,
  .evidence-list {
    grid-column: 2;
  }

  .architecture-composition {
    display: grid;
    grid-template-columns: minmax(15rem, 1fr) minmax(15rem, 0.8fr);
    gap: var(--space-8);
    margin-block-start: var(--space-6);
  }

  .architecture-flow,
  .compact-flow {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .architecture-flow {
    display: grid;
    justify-items: start;
  }

  .architecture-flow li {
    inline-size: min(100%, 25rem);
    min-block-size: var(--touch-target-min);
    display: flex;
    position: relative;
    align-items: center;
    padding-inline: var(--space-4);
    border-inline-start: var(--border-width-strong) solid
      var(--color-border-strong);
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .architecture-flow li:not(:last-child)::after,
  .compact-flow li:not(:last-child)::after {
    content: '↓';
    position: absolute;
    inset-block-end: calc(-1 * var(--space-4));
    inset-inline-start: var(--space-6);
    z-index: var(--z-index-raised);
    padding-inline: var(--space-1);
    background: var(--color-canvas);
    color: var(--color-text-muted);
  }

  .infrastructure {
    padding-inline-start: var(--space-4);
    border-inline-start: var(--border-width) solid var(--color-border);
  }

  .infrastructure h3 {
    font-size: var(--font-size-body);
  }

  .infrastructure-tree {
    margin-block-start: var(--space-5);
  }

  .infrastructure-tree > p {
    padding-block-end: var(--space-3);
    border-block-end: var(--border-width-strong) solid
      var(--color-border-strong);
  }

  .infrastructure-tree ul,
  .infrastructure-notes,
  .code-list,
  .docker-evidence ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .infrastructure-tree ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .infrastructure-tree li {
    padding-block-start: var(--space-3);
    border-inline-start: var(--border-width) solid var(--color-border);
    text-align: center;
  }

  .infrastructure-notes {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .evidence-section {
    grid-template-columns: minmax(12rem, 0.35fr) minmax(0, 1.65fr);
  }

  .evidence-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-7);
  }

  .evidence-item {
    min-inline-size: 0;
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .evidence-item--featured {
    padding-inline-start: var(--space-5);
    border-block-start-width: var(--border-width-strong);
    border-inline-start: var(--border-width-strong) solid
      var(--color-border-strong);
  }

  .evidence-item h3 {
    margin-block-start: var(--space-2);
    font-size: var(--font-size-heading-sm);
  }

  .evidence-item > p:not(.evidence-label) {
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
  }

  .comparison {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-4);
    align-items: center;
    margin-block-start: var(--space-5);
  }

  .comparison > div {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border-inline-start: var(--border-width-strong) solid var(--color-border);
  }

  .comparison span,
  .limitation {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .code-list,
  .docker-evidence,
  .compact-flow {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-5);
  }

  .code-list li,
  .docker-evidence,
  .compact-flow li {
    min-inline-size: 0;
    padding: var(--space-3);
    border-inline-start: var(--border-width) solid var(--color-border-strong);
    background: var(--color-surface-subtle);
    overflow-wrap: anywhere;
  }

  .compact-flow li {
    position: relative;
  }

  .docker-evidence ul {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }

  .closing-sections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .closing-sections section {
    padding-inline-start: var(--space-4);
    border-inline-start: var(--border-width-strong) solid var(--color-border);
  }

  .closing-sections h2 {
    margin-block-start: var(--space-2);
  }

  .closing-sections section > p:last-child {
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
  }

  .project-footer {
    padding-block: var(--space-7);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .project-footer span {
    margin-inline-start: var(--space-2);
  }

  @media (width < 64rem) {
    .architecture-composition,
    .evidence-list {
      grid-template-columns: 1fr;
    }
  }

  @media (width < 48rem) {
    .case-section,
    .evidence-section,
    .closing-sections {
      grid-template-columns: 1fr;
    }

    .architecture-copy,
    .architecture-composition,
    .evidence-list {
      grid-column: auto;
    }

    .comparison {
      grid-template-columns: 1fr;
    }

    .comparison > span {
      transform: rotate(90deg);
      justify-self: start;
    }

    .infrastructure-tree ul {
      grid-template-columns: 1fr;
    }

    .infrastructure-tree li {
      text-align: start;
    }
  }
</style>
