---
import type { Locale } from '@i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy =
  locale === 'en'
    ? {
        eyebrow: 'Portfolio v2 · visual prototype',
        title: 'Technical clarity with controlled energy.',
        lead: 'A dark-first foundation for a professional portfolio: calm neutral depth, precise typography and project accents used as evidence—not decoration.',
        body: 'This isolated prototype validates visual roles only. The current information architecture and public project stories remain unchanged.',
        meta: 'V0 foundation · Astro static HTML + CSS · zero client JavaScript',
        primary: 'Primary action',
        secondary: 'Secondary action',
        textLink: 'Editorial text link',
        external: 'External treatment',
        actionsLabel: 'Interaction state samples',
        surfaces: 'Surface grammar',
        open: 'Open section',
        openCopy:
          'Canvas-led content with rhythm and whitespace doing the structural work.',
        subtle: 'Subtle surface',
        subtleCopy:
          'Low-contrast grouping for supporting context without creating a card wall.',
        raised: 'Raised evidence',
        raisedCopy:
          'Selective elevation for one object that needs visual priority.',
        technical: 'Transparent technical layer',
        technicalCopy:
          'Semantic structure stays visible through rails, code and measured contrast.',
        projects: 'Project accent grammar',
        questboard: 'QuestBoard',
        questboardCopy:
          'Workflow states and backend invariants use blue, cyan and indigo as a bounded system accent.',
        questboardFlowLabel: 'QuestBoard workflow sample',
        duckyarena: 'DuckyArena',
        duckyarenaCopy:
          'Game evidence uses green, straw and orange, with BLUE / RED reserved for team meaning.',
        duckyarenaTeamsLabel: 'DuckyArena team color sample',
        tags: 'Representative technology labels',
        image: 'Evidence frame',
        imageAlt:
          'DuckyArena combat interface showing an active Duckie duel and technical challenge.',
        imageCaption:
          'A real DuckyArena combat capture demonstrates the proposed dark screenshot-frame treatment.',
        rhythm: 'Responsive rhythm',
        rhythmCopy:
          'Spacing compresses by breakpoint; surfaces flatten and actions wrap without shrinking readable labels.',
        motion: 'Motion baseline',
        motionCopy:
          'Hover and focus reveal hierarchy with micro motion. Reduced motion preserves every state without translation.',
      }
    : {
        eyebrow: 'Portfolio v2 · prototipo visual',
        title: 'Claridad técnica con energía controlada.',
        lead: 'Una base dark-first para un portfolio profesional: profundidad neutra, tipografía precisa y acentos de proyecto utilizados como evidencia, no como decoración.',
        body: 'Este prototipo aislado valida únicamente los roles visuales. La arquitectura de información y los casos de estudio públicos no cambian.',
        meta: 'Base V0 · HTML + CSS estático con Astro · cero JavaScript cliente',
        primary: 'Acción principal',
        secondary: 'Acción secundaria',
        textLink: 'Enlace editorial',
        external: 'Tratamiento externo',
        actionsLabel: 'Muestras de estados de interacción',
        surfaces: 'Gramática de superficies',
        open: 'Sección abierta',
        openCopy:
          'Contenido sobre el lienzo donde el ritmo y el espacio construyen la estructura.',
        subtle: 'Superficie sutil',
        subtleCopy:
          'Agrupación de bajo contraste para contexto secundario sin crear un muro de tarjetas.',
        raised: 'Evidencia elevada',
        raisedCopy:
          'Elevación selectiva para un único objeto que necesita prioridad visual.',
        technical: 'Capa técnica transparente',
        technicalCopy:
          'La estructura semántica permanece visible mediante raíles, código y contraste medido.',
        projects: 'Gramática de acentos de proyecto',
        questboard: 'QuestBoard',
        questboardCopy:
          'Los estados de workflow y las invariantes backend usan azul, cian e índigo como acento acotado.',
        questboardFlowLabel: 'Muestra del workflow de QuestBoard',
        duckyarena: 'DuckyArena',
        duckyarenaCopy:
          'La evidencia de juego usa verde, paja y naranja; BLUE / RED se reserva para significado de equipo.',
        duckyarenaTeamsLabel: 'Muestra de colores de equipo de DuckyArena',
        tags: 'Etiquetas tecnológicas representativas',
        image: 'Marco de evidencia',
        imageAlt:
          'Interfaz de combate de DuckyArena con un duelo activo de Duckies y un reto técnico.',
        imageCaption:
          'Una captura real del combate de DuckyArena demuestra el tratamiento oscuro propuesto para evidencias.',
        rhythm: 'Ritmo responsive',
        rhythmCopy:
          'El espaciado se comprime por breakpoint; las superficies se simplifican y las acciones envuelven sin reducir etiquetas legibles.',
        motion: 'Base de movimiento',
        motionCopy:
          'Hover y foco revelan jerarquía con micromovimiento. Reduced motion conserva cada estado sin traslación.',
      };
---

<div class="prototype" data-theme="v2-dark">
  <div class="prototype__container">
    <header class="prototype-hero">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
      <p class="body-copy">{copy.body}</p>
      <p class="meta">{copy.meta}</p>
      <div class="actions" aria-label={copy.actionsLabel}>
        <a class="button button--primary" href="#surfaces">{copy.primary}</a>
        <a class="button button--secondary" href="#projects">{copy.secondary}</a
        >
        <a class="text-link" href="#rhythm">{copy.textLink}</a>
        <a
          class="text-link"
          href="https://github.com/Martret92"
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.external}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <section
      id="surfaces"
      class="prototype-section"
      aria-labelledby="surface-title"
    >
      <div class="section-heading">
        <span>01</span><h2 id="surface-title">{copy.surfaces}</h2>
      </div>
      <div class="surface-grid">
        <article class="surface surface--open">
          <h3>{copy.open}</h3><p>{copy.openCopy}</p>
        </article>
        <article class="surface surface--subtle">
          <h3>{copy.subtle}</h3><p>{copy.subtleCopy}</p>
        </article>
        <article class="surface surface--raised">
          <h3>{copy.raised}</h3><p>{copy.raisedCopy}</p>
        </article>
        <article class="surface surface--technical">
          <h3>{copy.technical}</h3><p>{copy.technicalCopy}</p><code
            >state → invariant → evidence</code
          >
        </article>
      </div>
    </section>

    <section
      id="projects"
      class="prototype-section"
      aria-labelledby="projects-title"
    >
      <div class="section-heading">
        <span>02</span><h2 id="projects-title">{copy.projects}</h2>
      </div>
      <div class="project-grid">
        <article class="project-sample" data-project="questboard">
          <p class="eyebrow">Backend system</p><h3>{copy.questboard}</h3><p>
            {copy.questboardCopy}
          </p>
          <ol class="state-flow" aria-label={copy.questboardFlowLabel}>
            <li>BACKLOG</li><li>READY</li><li>IN_PROGRESS</li><li>REVIEW</li><li
            >
              DONE
            </li>
          </ol>
        </article>
        <article class="project-sample" data-project="duckyarena">
          <p class="eyebrow">Realtime game system</p><h3>
            {copy.duckyarena}
          </h3><p>{copy.duckyarenaCopy}</p>
          <div class="team-signal" aria-label={copy.duckyarenaTeamsLabel}>
            <span>BLUE</span><span>RED</span>
          </div>
        </article>
      </div>
      <div class="tag-group" aria-label={copy.tags}>
        {
          ['Python', 'Django', 'PostgreSQL', 'Socket.IO', 'Astro'].map(
            (tag) => <code>{tag}</code>,
          )
        }
      </div>
    </section>

    <section
      class="prototype-section image-section"
      aria-labelledby="image-title"
    >
      <div class="section-heading">
        <span>03</span><h2 id="image-title">{copy.image}</h2>
      </div>
      <figure class="evidence-frame">
        <img
          src="/images/projects/duckyarena/04-combat-redacted-1000.jpg"
          width="1000"
          height="1041"
          alt={copy.imageAlt}
          loading="lazy"
          decoding="async"
        />
        <figcaption>{copy.imageCaption}</figcaption>
      </figure>
    </section>

    <section
      id="rhythm"
      class="prototype-section rhythm-section"
      aria-labelledby="rhythm-title"
    >
      <div class="section-heading">
        <span>04</span><h2 id="rhythm-title">{copy.rhythm}</h2>
      </div>
      <div class="rhythm-content">
        <p>{copy.rhythmCopy}</p><aside>
          <p class="eyebrow">{copy.motion}</p><p>{copy.motionCopy}</p>
        </aside>
      </div>
    </section>
  </div>
</div>

<style>
  .prototype {
    min-block-size: 100vh;
    background: var(--color-canvas);
    color: var(--color-text);
    font-family: var(--font-family-body);
  }
  .prototype__container {
    inline-size: min(calc(100% - 2 * var(--layout-gutter)), 84rem);
    margin-inline: auto;
    padding-block: clamp(var(--space-7), 8vw, 7rem);
  }
  .prototype :where(h1, h2, h3, p, figure) {
    margin-block: 0;
  }
  .prototype-hero {
    max-inline-size: 68rem;
    display: grid;
    gap: var(--space-5);
    padding-block-end: clamp(var(--space-8), 12vw, 9rem);
  }
  .eyebrow,
  .meta,
  .section-heading span {
    color: var(--color-text-soft);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h1 {
    max-inline-size: 15ch;
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.045em;
    line-height: 1.02;
  }
  h2 {
    font-size: var(--font-size-heading-md);
  }
  h3 {
    font-size: var(--font-size-heading-sm);
  }
  .lead {
    max-inline-size: 62ch;
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
  }
  .body-copy {
    max-inline-size: var(--content-measure);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-3);
  }
  .button,
  .text-link {
    min-block-size: var(--touch-target-min);
    inline-size: fit-content;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--font-weight-medium);
  }
  .button {
    padding-inline: var(--space-5);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition:
      transform var(--motion-duration-micro) var(--motion-easing-enter),
      border-color var(--motion-duration-micro),
      background-color var(--motion-duration-micro);
  }
  .button--primary {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #06101e;
  }
  .button--secondary {
    background: var(--color-surface);
    color: var(--color-text);
  }
  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-accent-secondary);
  }
  .text-link {
    padding-inline: var(--space-2);
    text-decoration-color: var(--color-border-strong);
  }
  .prototype-section {
    display: grid;
    grid-template-columns: minmax(11rem, 0.45fr) minmax(0, 1.55fr);
    gap: var(--space-6) clamp(var(--space-6), 7vw, var(--space-9));
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    border-block-start: var(--border-width) solid var(--color-border);
  }
  .section-heading {
    align-self: start;
    padding-inline-start: var(--space-4);
    border-inline-start: var(--border-width-strong) solid var(--color-accent);
  }
  .section-heading h2 {
    margin-block-start: var(--space-2);
  }
  .surface-grid,
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .surface {
    min-block-size: 13rem;
    padding: clamp(var(--space-5), 4vw, var(--space-7));
  }
  .surface p,
  .project-sample > p {
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
  }
  .surface--open {
    padding-inline: 0;
  }
  .surface--subtle {
    background: var(--color-surface-subtle);
    border-block-start: var(--border-width) solid var(--color-border-strong);
  }
  .surface--raised {
    background: var(--color-surface-raised);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-raised);
  }
  .surface--technical {
    position: relative;
    border-inline-start: var(--border-width-strong) solid
      var(--color-accent-secondary);
    background: linear-gradient(90deg, rgb(71 228 224 / 7%), transparent 60%);
  }
  .surface--technical code {
    display: block;
    margin-block-start: var(--space-5);
    color: var(--color-accent-secondary);
  }
  .project-sample {
    --local-accent: var(--project-accent);
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    border-block-start: var(--border-width-strong) solid var(--project-accent);
    background: var(--project-accent-surface);
  }
  .project-sample h3 {
    margin-block-start: var(--space-3);
  }
  .project-sample .eyebrow {
    color: var(--project-accent);
  }
  .state-flow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-6) 0 0;
    list-style: none;
  }
  .state-flow li {
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--project-accent);
    color: var(--project-accent-soft);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
  }
  .team-signal {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }
  .team-signal span {
    min-block-size: var(--touch-target-min);
    display: grid;
    place-items: center;
    border: var(--border-width) solid currentColor;
    font-family: var(--font-family-mono);
    font-weight: var(--font-weight-bold);
  }
  .team-signal span:first-child {
    color: var(--project-team-blue);
  }
  .team-signal span:last-child {
    color: var(--project-team-red);
  }
  .tag-group {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-5);
  }
  .tag-group code {
    padding: var(--space-2) var(--space-3);
    border-block-end: var(--border-width) solid var(--color-border-strong);
    color: var(--color-text-muted);
  }
  .evidence-frame {
    overflow: hidden;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }
  .evidence-frame img {
    inline-size: 100%;
  }
  .evidence-frame figcaption {
    padding: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
  .rhythm-content {
    display: grid;
    grid-template-columns: 1fr minmax(16rem, 0.7fr);
    gap: var(--space-7);
  }
  .rhythm-content aside {
    padding-inline-start: var(--space-5);
    border-inline-start: var(--border-width-strong) solid
      var(--color-accent-strong);
  }
  .rhythm-content aside p:last-child {
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
  }
  @media (width < 64rem) {
    .surface-grid {
      grid-template-columns: 1fr;
    }
    .surface--open {
      min-block-size: auto;
    }
  }
  @media (width < 48rem) {
    .prototype__container {
      inline-size: min(calc(100% - 2rem), 84rem);
    }
    .prototype-section,
    .project-grid,
    .rhythm-content {
      grid-template-columns: 1fr;
    }
    .tag-group {
      grid-column: auto;
    }
    .surface,
    .project-sample {
      padding: var(--space-5);
    }
    .surface--raised {
      box-shadow: var(--shadow-md);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .button:hover,
    .button:focus-visible {
      transform: none;
    }
  }
</style>
