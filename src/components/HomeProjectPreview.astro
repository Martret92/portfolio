---
import type { ProductVisual } from '../types/inspection';

interface PreviewCopy {
  eyebrow: string;
  title: string;
  summary: string;
  workflowLabel: string;
  workflowSummary: string;
  resultLabel: string;
  resultSummary: string;
  topologyLabel: string;
  configureLabel: string;
  generateLabel: string;
  generatedDataLabel: string;
  previewLabel: string;
  exportLabel: string;
  boundaryLabel: string;
  boundaryCopy: string;
  cta: string;
  repositoryCta: string;
}

interface Props {
  copy: PreviewCopy;
  href: string;
  productVisual: ProductVisual;
}

const { copy, href, productVisual } = Astro.props;
const repositoryUrl = 'https://github.com/Martret92/devdata-generator';
---

<section
  class="selected-work"
  aria-labelledby="selected-work-heading"
  data-home-project-preview
>
  <header class="selected-work__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="selected-work-heading">{copy.title}</h2>
    <p>{copy.summary}</p>
  </header>

  <div class="selected-work__composition">
    <figure class="product-capture">
      <img
        src={productVisual.optimizedSrc}
        width={productVisual.width}
        height={productVisual.height}
        alt={productVisual.alt}
        loading="lazy"
        decoding="async"
      />
      <figcaption>{productVisual.caption}</figcaption>
    </figure>

    <div class="selected-work__evidence">
      <section>
        <p>{copy.workflowLabel}</p>
        <h3>{copy.workflowSummary}</h3>
        <ol class="compact-flow" aria-label={copy.topologyLabel}>
          <li>{copy.configureLabel}</li>
          <li>{copy.generateLabel}</li>
          <li><code>{copy.generatedDataLabel}</code></li>
          <li>
            <span>{copy.previewLabel}</span>
            <span>{copy.exportLabel}</span>
          </li>
        </ol>
      </section>

      <section>
        <p>{copy.resultLabel}</p>
        <h3>{copy.resultSummary}</h3>
      </section>

      <section class="browser-boundary">
        <p>{copy.boundaryLabel}</p>
        <h3>{copy.boundaryCopy}</h3>
      </section>

      <div class="selected-work__actions">
        <a class="button-primary" href={href}>
          {copy.cta}<span aria-hidden="true">→</span>
        </a>
        <a
          class="button-secondary"
          href={repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.repositoryCta}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .selected-work {
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
    border-block: var(--border-width) solid var(--color-border);
  }

  .selected-work__header {
    max-inline-size: 54rem;
    display: grid;
    gap: var(--space-3);
    margin-block-end: clamp(var(--space-6), 6vw, var(--space-8));
  }

  .eyebrow,
  .selected-work__evidence section > p {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  h2,
  h3,
  .selected-work__header > p,
  .product-capture {
    margin: 0;
  }

  h2 {
    font-size: var(--font-size-heading-md);
  }

  .selected-work__header > p:last-child {
    max-inline-size: var(--content-measure);
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
  }

  .selected-work__composition {
    display: grid;
    grid-template-columns: minmax(14rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(var(--space-6), 6vw, var(--space-8));
    align-items: start;
  }

  .product-capture {
    min-inline-size: 0;
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border-strong);
    background: var(--color-surface-subtle);
  }

  .product-capture img {
    inline-size: 100%;
    block-size: auto;
  }

  .product-capture figcaption {
    margin-block-start: var(--space-3);
    padding-inline-start: var(--space-3);
    border-inline-start: var(--border-width-strong) solid var(--color-accent);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .selected-work__evidence {
    min-inline-size: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .selected-work__evidence section {
    min-inline-size: 0;
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .selected-work__evidence section:first-child {
    grid-column: 1 / -1;
    border-block-start-color: var(--color-border-strong);
  }

  .selected-work__evidence h3 {
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-family-body);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-loose);
  }

  .selected-work__evidence section:first-child h3 {
    max-inline-size: 48rem;
    color: var(--color-text);
    font-size: var(--font-size-lead);
    font-weight: var(--font-weight-medium);
  }

  .compact-flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(10rem, 1.2fr);
    gap: var(--space-3);
    padding: 0;
    margin: var(--space-6) 0 0;
    list-style: none;
  }

  .compact-flow li {
    min-inline-size: 0;
    padding-block-start: var(--space-3);
    border-block-start: var(--border-width-strong) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .compact-flow li:not(:last-child)::after {
    float: inline-end;
    color: var(--color-accent);
    content: '→';
  }

  .compact-flow code {
    color: var(--color-accent-secondary);
    font-size: inherit;
  }

  .compact-flow li:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    border-block-start-color: var(--color-accent);
    color: var(--color-text);
  }

  .selected-work__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }

  .selected-work__actions a {
    min-block-size: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width-strong) solid var(--color-border-strong);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .button-primary {
    background: var(--color-interactive);
    color: var(--color-canvas);
  }

  .button-primary:hover {
    background: var(--color-interactive-hover);
    color: var(--color-canvas);
  }

  .button-secondary {
    background: var(--color-surface-subtle);
    color: var(--color-text);
  }

  .button-secondary:hover {
    border-color: var(--color-interactive-hover);
    background: var(--color-surface-raised);
  }

  @media (width < 64rem) {
    .selected-work__composition {
      grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr);
    }

    .compact-flow {
      grid-template-columns: 1fr;
    }

    .compact-flow li:not(:last-child)::after {
      float: none;
      display: block;
      margin-block-start: var(--space-2);
      content: '↓';
    }
  }

  @media (width < 48rem) {
    .selected-work__composition,
    .selected-work__evidence {
      grid-template-columns: 1fr;
    }

    .product-capture {
      inline-size: min(100%, 29rem);
    }

    .selected-work__evidence section:first-child,
    .selected-work__actions {
      grid-column: auto;
    }
  }
</style>
